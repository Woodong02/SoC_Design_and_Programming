digraph G {
    rankdir=TB;
    fontname="Noto Sans CJK KR";
    node [shape=box, fontname="Noto Sans CJK KR", fontsize=14, color=black];
    edge [fontname="Noto Sans CJK KR", fontsize=10, color=black, arrowsize=0.6];

    EXT [label="외부 테스트 장치", shape=ellipse];
    PS  [label="PS", shape=ellipse];
    DIP [label="DIP Switch"];
    PB  [label="Push Button"];
    MASTER [label="Master IP"];
    SEG [label="7-Segment"];
    TXP [label="TX 포트"];
    RXP [label="RX 포트"];
    GND [label="GND"];
    LED [label="LED"];

    { rank=same; EXT; PS; }
    { rank=same; DIP; MASTER; SEG; }
    { rank=same; PB; TXP; }
    { rank=same; RXP; GND; }
    { rank=same; LED; }

    EXT -> PS  [label="UART", dir=both];
    PS  -> MASTER [label="AXI-Lite", dir=both];
    DIP -> MASTER;
    PB  -> MASTER [label="resetn_bt"];
    MASTER -> SEG;
    MASTER -> TXP [label="GPIO_out"];
    RXP -> MASTER [label="GPIO_in"];
    GND -> LED;
    TXP -> LED;
    RXP -> LED;
}
