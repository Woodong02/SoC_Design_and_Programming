flowchart LR
    PS(["PS (ARM Core)"]):::io

    subgraph V1 ["Master_v1_0 (PS-PL 경계)"]
        direction TB
        AXIREG["Master_v1_0_S00_AXI<br/>AXI-Lite 레지스터<br/>(slv_reg0..20)"]:::axi
    end

    subgraph TOP ["master_top"]
        direction TB
        SLOT["Master_slot<br/>슬롯 스케줄러<br/>(DIV,GUARD_TICKS,NODE_CNT)"]:::core
        TX["Master_tx<br/>NRZ 송신"]:::core
        RX["Master_rx<br/>NRZ 수신 · 프리앰블 검출"]:::core
        DEC["Master_dec_ham<br/>Hamming 복호 · 에러 집계"]:::core
        HALT["halt_cmd 판정<br/>err_cnt &gt; FAULT_TH"]:::logic
        DISP["seven_seg / TFTLCDctrl<br/>(디스플레이 주변장치)"]:::periph
    end

    GPIO_OUT(["GPIO_out → 공유 버스"]):::io
    GPIO_IN(["공유 버스 → GPIO_in"]):::io

    PS <-->|"AXI-Lite"| AXIREG
    AXIREG -->|"DIV, GUARD_TICKS,<br/>NODE_CNT, ENABLE,<br/>FAULT_TH, SILENT_TH"| SLOT
    SLOT -->|"slot, slot_change,<br/>cycle_cnt"| TX
    SLOT -->|"rx_stat"| RX
    SLOT -->|"slot, clk_cnt"| DISP

    GPIO_IN --> RX
    RX -->|"data_out, out_sig,<br/>preamble_err"| DEC
    DEC -->|"err_cnt0..7,<br/>slot_out0..7"| HALT
    HALT -->|"halt_cmd"| TX
    HALT -->|"halt_cmd"| DEC
    TX --> GPIO_OUT

    DEC -->|"slot_out, err_cnt"| DISP
    DEC -->|"slot_out0..7, err_cnt0..7"| AXIREG

    classDef io fill:#2D2D2D,stroke:#111111,color:#FFFFFF
    classDef axi fill:#E0E0E0,stroke:#999999,stroke-width:0.8px,color:#222222
    classDef core fill:#FFFFFF,stroke:#111111,stroke-width:1.2px,color:#222222
    classDef logic fill:#F2F2F2,stroke:#999999,stroke-width:0.8px,color:#222222
    classDef periph fill:#F2F2F2,stroke:#999999,stroke-width:0.8px,color:#666666
