flowchart LR
    PS(["PS<br/>(ARM Core)"]):::io

    subgraph STAGE1 ["① 설정: PS → PL"]
        direction TB
        AXIREG["Master_v1_0_S00_AXI<br/>AXI-Lite 레지스터"]:::axi
        SLOT["Master_slot<br/>슬롯 스케줄러"]:::core
        AXIREG -->|"DIV,GUARD_TICKS,<br/>NODE_CNT,ENABLE..."| SLOT
    end

    subgraph STAGE2 ["② 수신 · 에러 처리"]
        direction TB
        GPIOIN(["공유 버스<br/>GPIO_in"]):::io
        RX["Master_rx<br/>NRZ 수신"]:::core
        DEC["Master_dec_ham<br/>Hamming 복호"]:::core
        HALT["halt_cmd 판정"]:::logic
        GPIOIN --> RX
        RX -->|"data_out,out_sig"| DEC
        DEC -->|"err_cnt,slot_out"| HALT
    end

    subgraph STAGE3 ["③ 송신 · 출력"]
        direction TB
        TX["Master_tx<br/>NRZ 송신"]:::core
        GPIOOUT(["공유 버스<br/>GPIO_out"]):::io
        DISP["seven_seg /<br/>TFTLCDctrl"]:::periph
        TX --> GPIOOUT
    end

    PS <-->|"AXI-Lite"| AXIREG
    SLOT -->|"rx_stat"| RX
    SLOT -->|"slot,cycle_cnt"| TX
    HALT -->|"halt_cmd"| TX
    HALT -->|"halt_cmd"| DEC
    DEC -.->|"slot_out,err_cnt"| AXIREG
    SLOT -->|"slot,clk_cnt"| DISP
    DEC -->|"slot_out,err_cnt"| DISP

    classDef io fill:#2D2D2D,stroke:#111111,color:#FFFFFF,font-weight:bold
    classDef axi fill:#E0E0E0,stroke:#999999,stroke-width:1px,color:#111111,font-weight:bold
    classDef core fill:#FFFFFF,stroke:#111111,stroke-width:1.5px,color:#111111,font-weight:bold
    classDef logic fill:#F2F2F2,stroke:#999999,stroke-width:1px,color:#111111,font-weight:bold
    classDef periph fill:#F2F2F2,stroke:#999999,stroke-width:1px,color:#666666
