flowchart LR
    subgraph SlaveTop ["slave_ip_top"]
        direction TB
        CFG["slave_cfg_shadow<br/>(설정 섀도우)"]:::core
        SYNC["slave_sync_detector"]:::core
        BRX["slave_broadcast_rx"]:::core
        BDEC["slave_broadcast_decoder"]:::core
        TSCH["slave_timing_scheduler"]:::core
        SSEQ["slave_slot_sequencer"]:::core
        PTBL["slave_payload_table"]:::core
        FBLD["slave_frame_builder"]:::core
        TXS["slave_tx_serializer"]:::core
        STE["slave_status_event<br/>(STATUS/EVENT/FAULT/IRQ)"]:::logic

        SYNC -->|"sync_pulse"| BRX
        SYNC -->|"sync_pulse"| TSCH
        BRX -->|"rx_codeword"| BDEC
        BDEC -->|"halt_mask, guard_ticks"| CFG
        TSCH -->|"slot_time_match<br/>schedule_active"| SSEQ
        CFG -->|"cfg_active_slot<br/>cfg_data_out0..5"| SSEQ
        SSEQ -->|"tx_cmd_slot_id"| PTBL
        PTBL -->|"selected_payload"| FBLD
        SSEQ -->|"tx_cmd_valid"| FBLD
        FBLD -->|"tx_frame"| TXS
        TXS -->|"tx_cmd_ready/accept"| SSEQ

        SYNC --> STE
        BRX --> STE
        SSEQ --> STE
        TXS --> STE
        CFG --> STE
    end

    MIN(["i_master_serial"]):::io
    SOUT(["o_slave_serial / o_slave_oe"]):::io
    IRQ(["o_irq"]):::io

    MIN --> SYNC
    TXS --> SOUT
    STE --> IRQ

    classDef core fill:#FFFFFF,stroke:#111111,stroke-width:1.2px,color:#222222
    classDef logic fill:#E0E0E0,stroke:#999999,stroke-width:0.8px,color:#222222
    classDef io fill:#2D2D2D,stroke:#111111,color:#FFFFFF
