%%{init: {'themeVariables': {'fontSize': '34px'}}, 'flowchart': {'nodeSpacing': 40, 'rankSpacing': 70}}%%
flowchart LR
    EXT(["외부 테스트 장치"]):::node
    GPIO["GPIO"]:::dim
    PL["PL (Master IP 포함)"]:::dim

    subgraph PSB ["PS"]
        direction TB
        INIT["인터럽트 초기화"]:::node
        CFG["마스터 설정"]:::node
        UARTCMD["UART 명령 인터페이스"]:::node
        ISR["인터럽트 처리"]:::node
        CTRLREG["제어 레지스터"]:::node

        INIT --> CFG
        CFG <--> CTRLREG
        UARTCMD <--> CTRLREG
        ISR -.->|"상태 로그"| UARTCMD
    end

    EXT <-->|"UART"| UARTCMD
    CTRLREG <-->|"AXI4-Lite"| PL
    ISR <-->|"AXI4-Lite (인터럽트)"| PL
    GPIO <--> PL
classDef node fill:#FFFFFF,stroke:#111111,stroke-width:1.5px,color:#111111,font-weight:bold,font-size:34px
classDef dim fill:#F2F2F2,stroke:#AAAAAA,color:#777777,font-weight:bold,font-size:34px
