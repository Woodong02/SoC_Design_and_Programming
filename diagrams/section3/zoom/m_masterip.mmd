%%{init: {'themeVariables': {'fontSize': '34px'}}, 'flowchart': {'nodeSpacing': 35, 'rankSpacing': 55}}%%
flowchart LR
    EXT(["외부 테스트 장치"]):::node
    PS["PS"]:::dim
    GPIO["GPIO"]:::dim
    PLPERIPH["PL 주변기기\n(LED/DIP/PB/SEG)"]:::dim

    subgraph MASTERB ["Master IP"]
        direction LR
        subgraph REGGROUP [" "]
            direction TB
            CTRLREG["제어 레지스터"]:::node
            SLOT["슬롯 스케줄러"]:::node
            CTRLREG ~~~ SLOT
        end
        RX["NRZ 수신"]:::node
        DEC["Hamming 복호"]:::node
        SLOTDET["슬롯 판별"]:::node
        HALT["halt_cmd 판정"]:::node
        TX["NRZ 송신"]:::node

        REGGROUP ~~~ RX
        RX --> DEC
        DEC --> SLOTDET
        SLOTDET --> HALT
        HALT --> TX
    end

    EXT <-->|"UART"| PS
    PS <--> MASTERB
    GPIO --> RX
    TX --> GPIO
    MASTERB --> PLPERIPH
classDef node fill:#FFFFFF,stroke:#111111,stroke-width:1.5px,color:#111111,font-weight:bold,font-size:34px
classDef dim fill:#F2F2F2,stroke:#AAAAAA,color:#777777,font-weight:bold,font-size:34px
style REGGROUP fill:none,stroke:none
