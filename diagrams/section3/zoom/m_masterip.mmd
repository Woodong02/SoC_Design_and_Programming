%%{init: {'themeVariables': {'fontSize': '34px'}}, 'flowchart': {'nodeSpacing': 35, 'rankSpacing': 55}}%%
flowchart LR
    PS["PS"]:::dim
    GPIO["GPIO"]:::dim
    PLPERIPH["PL 주변기기\n(LED/DIP/PB/SEG)"]:::dim

    subgraph MASTERB ["Master IP"]
        direction LR
        AXI["AXI-Lite 레지스터"]:::node
        SLOT["슬롯 스케줄러"]:::node
        RX["NRZ 수신"]:::node
        DEC["Hamming 복호"]:::node
        HALT["halt_cmd 판정"]:::node
        TX["NRZ 송신"]:::node

        AXI --> SLOT
        SLOT --> RX
        RX --> DEC
        DEC --> HALT
        HALT --> TX
        HALT --> DEC
        SLOT --> TX
        DEC -.-> AXI
    end

    PS <--> AXI
    PLPERIPH --> AXI
    GPIO --> RX
    TX --> GPIO
    DEC --> PLPERIPH
    SLOT --> PLPERIPH
classDef node fill:#FFFFFF,stroke:#111111,stroke-width:1.5px,color:#111111,font-weight:bold,font-size:34px
classDef dim fill:#F2F2F2,stroke:#AAAAAA,color:#777777,font-weight:bold,font-size:34px
