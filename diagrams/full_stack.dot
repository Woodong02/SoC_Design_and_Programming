digraph G {
    rankdir=TB;
    fontname="Noto Sans CJK KR";
    node [shape=box, fontname="Noto Sans CJK KR", fontsize=14, color=black];
    edge [fontname="Noto Sans CJK KR", fontsize=10, color=black, arrowsize=0.6];

    EXT [label="외부 테스트 장치", shape=ellipse];
    GND [label="GND"];
    TXP [label="TX 포트"];
    RXP [label="RX 포트"];

    subgraph cluster_ps {
        label="PS";
        style=dashed;
        fontname="Noto Sans CJK KR";

        INIT [label="인터럽트 초기화"];
        CFG  [label="마스터 설정"];
        UARTCMD [label="UART 명령 인터페이스"];
        ISR  [label="인터럽트 처리"];
        POLL [label="상태 폴링 루프"];

        { rank=same; INIT; CFG; UARTCMD; }
        { rank=same; ISR; POLL; }

        INIT -> CFG;
        CFG  -> POLL;
        UARTCMD -> CFG [style=dashed];
        ISR  -> UARTCMD [style=dashed, label="상태 로그"];
    }


    subgraph cluster_pl {
        label="PL";
        style=dashed;
        fontname="Noto Sans CJK KR";

        LED [label="LED"];
        DIP [label="DIP Switch"];
        PB  [label="Push Button"];
        SEG [label="7-Segment"];

        subgraph cluster_master {
            label="Master IP";
            style=dashed;
            fontname="Noto Sans CJK KR";

            AXI  [label="AXI-Lite 레지스터"];
            SLOT [label="슬롯 스케줄러"];
            RX   [label="NRZ 수신"];
            DEC  [label="Hamming 복호"];
            HALT [label="halt_cmd 판정"];
            TX   [label="NRZ 송신"];

            { rank=same; AXI; }
            { rank=same; SLOT; }
            { rank=same; RX; }
            { rank=same; DEC; }
            { rank=same; HALT; TX; }

            AXI  -> SLOT [label="DIV,GUARD_TICKS.."];
            SLOT -> RX   [label="rx_stat"];
            RX   -> DEC  [label="data_out"];
            DEC  -> HALT [label="err_cnt"];
            HALT -> TX   [label="halt_cmd"];
            HALT -> DEC  [label="halt_cmd"];
            SLOT -> TX   [label="slot,cycle_cnt"];
            DEC  -> AXI  [label="slot_out,err_cnt", style=dashed];
        }

        { rank=same; LED; SEG; }

        DIP -> SEG;
        SLOT -> SEG;
        DEC  -> SEG;
        PB   -> AXI [label="resetn"];
    }

    { rank=same; GND; TXP; RXP; LED; }

    GND -> LED;
    TXP -> LED;
    RXP -> LED;
    TX  -> TXP [label="GPIO_out"];
    RXP -> RX  [label="GPIO_in"];

    EXT -> UARTCMD [label="UART", dir=both];
    CFG  -> AXI [label="AXI4-Lite (설정)"];
    POLL -> AXI [label="AXI4-Lite (폴링)", dir=both];
    ISR  -> AXI [label="AXI4-Lite (인터럽트)", dir=both];
}
